# Copy to .env and fill in values

# Database
DATABASE_URL=postgres://helicon:helicon_dev@localhost:7001/helicon

# setlist.fm API — get a key at https://www.setlist.fm/settings/api
SETLISTFM_API_KEY=

# App
PORT=7000
NODE_ENV=development

# Comma-separated hosts to allow through Vite's dev server (e.g. a Tailscale hostname)
VITE_ALLOWED_HOSTS=

# Production deployment (compose.prod.yml)
# POSTGRES_PASSWORD=change_me_in_production
#
# The app is served under /helicon. Add this to your shared Caddy config:
#
#   yourdomain.com {
#       reverse_proxy /helicon* helicon-app:7000
#       # other apps…
#   }
#
# Note: use reverse_proxy (not handle_path) so the /helicon prefix is passed
# through to the app intact.
