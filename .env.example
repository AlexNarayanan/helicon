# Copy to .env and fill in values (development only)
# For production, see .env.prod.example

# Database (dev — matches compose.yml postgres service on port 7001)
DATABASE_URL=postgres://helicon:helicon_dev@localhost:7001/helicon

# setlist.fm API — get a key at https://www.setlist.fm/settings/api
SETLISTFM_API_KEY=

# App
PORT=7000
NODE_ENV=development

# Comma-separated hosts to allow through Vite's dev server (e.g. a Tailscale hostname)
VITE_ALLOWED_HOSTS=
